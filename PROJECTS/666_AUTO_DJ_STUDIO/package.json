{
  "name": "666-auto-dj-studio",
  "version": "0.1.0",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --check app/main.js && node --check app/preload.js && node --check app/renderer.js",
    "dist": "electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.666soundsdesign.autodjstudio",
    "productName": "666 AutoDJ Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime/autodj-engine.exe",
        "to": "engine/autodj-engine.exe"
      },
      {
        "from": "build/runtime/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "build/runtime/ffprobe.exe",
        "to": "ffmpeg/ffprobe.exe"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "666_AUTO_DJ_STUDIO_${version}_${arch}.${ext}"
    },
    "portable": {
      "artifactName": "666_AUTO_DJ_STUDIO_${version}_${arch}_PORTABLE.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
