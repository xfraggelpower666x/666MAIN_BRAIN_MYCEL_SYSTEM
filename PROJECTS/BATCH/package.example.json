{
  "project_root": "..",
  "package": {
    "metadata": {
      "app_id": "Example.Application",
      "name": "Example Application",
      "publisher": "Example Publisher",
      "version": "1.0.0",
      "output_name": "Example-Application"
    },
    "output_dir": "dist/toolstarter",
    "entry": "Application.exe",
    "include": [
      {"from": "release-input/application", "to": "."},
      {"from": "release-input/tool", "to": "tools/helper"}
    ],
    "path_dirs": ["tools/helper"],
    "required_runtime_ids": ["helper"],
    "runtime": [
      {
        "id": "helper",
        "files": ["tools/helper/Helper.exe"],
        "licenses": ["tools/helper/LICENSE.txt"],
        "probes": [{"exe": "tools/helper/Helper.exe", "args": ["--version"]}]
      }
    ]
  }
}
