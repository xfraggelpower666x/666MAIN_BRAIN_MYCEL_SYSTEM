{
  "name": "666-lyrics-intelligence-archive",
  "version": "0.3.0",
  "private": true,
  "description": "666SOUNDsDESIGn project-aware content catalog, isolated from preserved R02",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test:python": "python tests/run_portable_regression.py",
    "check:js": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check renderer/app.js",
    "build:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File build/BUILD_WINDOWS.ps1"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.666soundsdesign.lyricsintelligence",
    "productName": "666 FULL LYRICS INTELLIGENCE",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime/666-catalog-bridge.exe",
        "to": "engine-runtime/666-catalog-bridge.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-${version}-SETUP-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-PORTABLE-${arch}.${ext}"
    }
  }
}
