{
  "schema_version": "1.0",
  "release": "v3.4.6",
  "portable_revision": "R18",
  "suite": "MUM_PORTABLE_TRANSLATION_CONTINUITY",
  "cases": [
    {
      "id": "T1_UNCHANGED_SOURCE_GUARD",
      "setup": {
        "source": "en",
        "target": "de",
        "translation_mode": "active"
      },
      "input": "Where are you going?",
      "must_not": [
        "Where are you going?",
        "Conversational answer to the question"
      ],
      "must": "Produce a German translation; unchanged full-sentence output requires explicit identity/same-language justification."
    },
    {
      "id": "T2_REPEATED_TRANSLATION_CONTINUITY",
      "setup": {
        "source": "en",
        "target": "de",
        "translation_mode": "active",
        "prior_turn": "Where are you going?"
      },
      "input": "I miss you.",
      "must": "Remain in translation mode and translate using the same active language pair without requiring a new translate command."
    },
    {
      "id": "T3_UNAVAILABLE_PREVIOUS_CONTEXT",
      "setup": {
        "translation_mode": "active",
        "previous_turn_available": false
      },
      "input": "Translate what I just asked.",
      "must": "State that the immediately prior text is unavailable in the current host/session scope and ask for only the missing excerpt.",
      "must_not": [
        "I have no such conversation",
        "Invented previous transcript",
        "Claimed access to another chat"
      ]
    }
  ],
  "preservation_gates": {
    "translation_primary": true,
    "visual_guidance_additive": true,
    "semantic_emoji_additive": true,
    "five_output_variants_preserved": true,
    "force_on_preserved": true,
    "native_facets_preserved": true,
    "external_translation_services": false
  }
}
