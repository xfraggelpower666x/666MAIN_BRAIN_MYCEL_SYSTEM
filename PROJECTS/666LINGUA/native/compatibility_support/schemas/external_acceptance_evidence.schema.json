{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "evidence_id",
    "kind",
    "status",
    "artifacts",
    "verdict"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "IOS",
        "ANDROID",
        "WHATSAPP",
        "BILINGUAL_REVIEW",
        "DELETE_READBACK"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "CONFLICT_QUARANTINE",
        "PENDING_EXTERNAL"
      ]
    },
    "artifacts": {
      "type": "array"
    },
    "verdict": {
      "type": "string"
    }
  }
}