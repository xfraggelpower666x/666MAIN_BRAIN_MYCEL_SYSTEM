{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Governed Candidate",
  "type": "object",
  "required": [
    "candidate_id",
    "source_type",
    "source_hash",
    "scope",
    "evidence",
    "conflicts",
    "privacy_class",
    "authority",
    "state",
    "created_at"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "correction",
        "human_review",
        "regression"
      ]
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "conflicts": {
      "type": "array"
    },
    "privacy_class": {
      "enum": [
        "minimal",
        "personal",
        "sensitive"
      ]
    },
    "authority": {
      "enum": [
        "user",
        "bilingual_reviewer",
        "automated_structure",
        "heuristic"
      ]
    },
    "state": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
