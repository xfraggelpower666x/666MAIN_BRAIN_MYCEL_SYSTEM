{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lyvra:dolmetscher:translation-variant-bundle:2.2.0",
  "title": "LYVRA Translation Variant Bundle",
  "type": "object",
  "required": [
    "bundle_id",
    "source_hash",
    "target_profile",
    "system_language",
    "primary",
    "alternatives"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_profile": {
      "type": "string"
    },
    "system_language": {
      "type": "string"
    },
    "primary": {
      "$ref": "#/$defs/variant"
    },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "share_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "NATIVE_SHARE_SHEET",
          "WHATSAPP_SHARE",
          "GENERIC_MESSENGER_SHARE",
          "COPY_TO_CLIPBOARD"
        ]
      }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "required": [
        "variant_id",
        "text",
        "content_hash",
        "semantic_lock",
        "share_targets"
      ],
      "properties": {
        "variant_id": {
          "enum": [
            "PRIMARY",
            "LOCAL_NATIVE",
            "TECHNICAL_PRECISE",
            "EMOTIONAL_PLUS"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_lock": {
          "const": true
        },
        "share_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "NATIVE_SHARE_SHEET",
              "WHATSAPP_SHARE",
              "GENERIC_MESSENGER_SHARE",
              "COPY_TO_CLIPBOARD"
            ]
          }
        },
        "emoji_profile": {
          "type": "string"
        },
        "label_system_language": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
