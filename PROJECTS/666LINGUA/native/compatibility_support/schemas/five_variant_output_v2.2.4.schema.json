{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lyvra:dolmetscher:five-variant-output:2.2.4",
  "type": "object",
  "required": [
    "variants"
  ],
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "variant_id",
          "sendable_text"
        ],
        "properties": {
          "variant_id": {
            "enum": [
              "PRIMARY",
              "LOCAL_NATIVE",
              "TECHNICAL_PRECISE",
              "EMOTIONAL_PLUS",
              "CHEEKY_PLAYFUL"
            ]
          },
          "sendable_text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
